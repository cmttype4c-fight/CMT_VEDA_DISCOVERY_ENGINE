# --- Database ---
DATABASE_URL=postgresql+psycopg://discovery:discovery@localhost:5432/discovery_engine
# Used by Alembic (sync) and the app (async engine derives from this too)

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# --- Auth (placeholder hooks until CMT Veda auth is integrated) ---
# Comma separated shared secrets accepted as bearer tokens for each role.
# Replace with real auth integration later (see app/auth.py).
AUTH_ADMIN_TOKENS=changeme-admin-token
AUTH_REVIEWER_TOKENS=changeme-reviewer-token
AUTH_SERVICE_TOKENS=changeme-service-token

# --- Worker ---
WORKER_CONCURRENCY=3
WORKER_POLL_INTERVAL_SECONDS=5
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_SECONDS=30

# --- Global scheduler (FINAL CORRECTION: SOURCE EXPANSION + 6:00 AM IST
# SCHEDULER) --- runs automatically inside the discovery-worker process,
# no separate cron/process needed. SCHEDULER_TIMEZONE is resolved via
# Python's zoneinfo, independent of the container/VPS's own system
# timezone -- see app/worker/ist_scheduler.py.
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=6
SCHEDULER_MINUTE=0
SCHEDULER_TIMEZONE=Asia/Kolkata

# --- Collectors ---
PUBMED_API_KEY=
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
PUBMED_RATE_LIMIT_PER_SEC=3
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
CLINICALTRIALS_RATE_LIMIT_PER_SEC=5

# Europe PMC (registered collector; not activated by default -- no source
# row is created for it automatically. See app/collectors/europepmc.py.)
EUROPEPMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
EUROPEPMC_RATE_LIMIT_PER_SEC=5

# --- Full-text / PDF acquisition ---
# "local" is the only implemented backend today. Must match the volume
# mount path in docker-compose.yml (discovery_documents_data) so full
# text survives container recreation and is shared between the API and
# worker containers.
FULLTEXT_STORAGE_BACKEND=local
FULLTEXT_STORAGE_DIR=/data/discovery-documents
FULLTEXT_MAX_BYTES=52428800

# --- AI Provider (Veda Intelligence) ---
AI_PROVIDER=mock
# e.g. "anthropic"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- RAG Adapter ---
RAG_ADAPTER=mock
# e.g. "http"
RAG_INGESTION_ENDPOINT=
RAG_INGESTION_API_KEY=
