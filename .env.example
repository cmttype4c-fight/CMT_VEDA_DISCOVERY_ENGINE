# --- Database ---
DATABASE_URL=postgresql+psycopg://discovery:discovery@localhost:5432/discovery_engine
# Used by Alembic (sync) and the app (async engine derives from this too)

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# --- Auth (placeholder hooks until CMT Veda auth is integrated) ---
# Comma separated shared secrets accepted as bearer tokens for each role.
# Replace with real auth integration later (see app/auth.py).
AUTH_ADMIN_TOKENS=changeme-admin-token
AUTH_REVIEWER_TOKENS=changeme-reviewer-token
AUTH_SERVICE_TOKENS=changeme-service-token

# --- Worker ---
WORKER_CONCURRENCY=3
WORKER_POLL_INTERVAL_SECONDS=5
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_SECONDS=30

# --- Collectors ---
PUBMED_API_KEY=
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
PUBMED_RATE_LIMIT_PER_SEC=3
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
CLINICALTRIALS_RATE_LIMIT_PER_SEC=5

# --- AI Provider (Veda Intelligence) ---
AI_PROVIDER=mock
# e.g. "anthropic"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- RAG Adapter ---
RAG_ADAPTER=mock
# e.g. "http"
RAG_INGESTION_ENDPOINT=
RAG_INGESTION_API_KEY=
